{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Calc Eletronica",
            "type": "shell",
            "command": "C:\\msys64\\mingw64\\bin\\gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c11",
                "${workspaceFolder}\\Calc_Eletronica.c",
                "${workspaceFolder}\\submenus\\calculadoraBasica.c",
                "${workspaceFolder}\\submenus\\calculadoraEletronica.c",
                "-o",
                "${workspaceFolder}\\calc.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}